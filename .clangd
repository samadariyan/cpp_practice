# Simplified clangd configuration for C++23 projects

# Use the compile_commands.json for accurate compilation info
CompileFlags:
  # Let compile_commands.json handle most flags
  Add: [
    "-std=c++23",
  ]

# Indexing settings
Index:
  Background: Build
  External: true

# Code completion settings
Completion:
  AllScopes: true
  Fuzzy: true

# Diagnostics settings
Diagnostics:
  UnusedIncludes: Strict

# Reference marking
References:
  Inline: true

# Semantic highlighting
SemanticHighlighting:
  Enabled: true

# Simple fallback for files not in compile_commands.json
FallbackFlags:
  - "-std=c++23"
  - "-I./src"
  - "-I./build/linux-arm-clang/vcpkg_installed/arm64-linux/include"