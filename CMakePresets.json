{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_COLOR_DIAGNOSTICS": "ON"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
        "ES_USE_SYSTEM_LIBRARIES": "OFF",
        "BUILD_TESTING": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "$env{CI}",
        "rhs": "true"
      }
    },
    {
      "name": "arm64",
      "hidden": true,
      "generator": "Ninja",
      "inherits": "base",
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "$env{CMAKE_HOST_SYSTEM_PROCESSOR}",
        "rhs": "arm64"
      }
    },
    {
      "name": "x86",
      "hidden": true,
      "generator": "Ninja",
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "$env{CMAKE_HOST_SYSTEM_PROCESSOR}",
        "rhs": "x86_64"
      }
    },
    {
      "name": "macos-x64-clang",
      "displayName": "MacOs Clang",
      "description": "Using compiler clang++",
      "inherits": "x86",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "VCPKG_TARGET_TRIPLET": "x64-osx-dynamic"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-x64-gcc",
      "displayName": "MacOS GCC",
      "description": "Using compiler g++-15",
      "inherits": "x86",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "VCPKG_TARGET_TRIPLET": "x64-osx-dynamic"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-arm",
      "displayName": "MacOS ARM",
      "description": "Builds with the default host compiler on ARM-based MacOS",
      "inherits": "arm64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-dynamic"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "cl",
      "displayName": "Windows cl",
      "description": "Builds with Visual C++ on Windows",
      "inherits": "x86",
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-x86-gcc",
      "displayName": "Linux GCC",
      "description": "Builds with the default host compiler on Linux",
      "inherits": "x86",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-x86-clang",
      "displayName": "Linux x86 Clang",
      "description": "Builds with the default host compiler on Linux",
      "inherits": "x86",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-arm-clang",
      "displayName": "Linux ARM Clang",
      "description": "Using compiler clang++-20",
      "inherits": "arm64",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "arm64-linux-dynamic",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-arm-gcc",
      "displayName": "Linux ARM GCC",
      "description": "Using compiler aarch64-linux-gnu-g++",
      "inherits": "arm64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-linux-dynamic",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "hidden": true,
      "configuration": "Debug"
    },
    {
      "name": "release",
      "hidden": true,
      "configuration": "Release"
    },
    {
      "name": "linux-x86-gcc-debug",
      "displayName": "Debug",
      "configurePreset": "linux-x86-gcc",
      "inherits": "debug"
    },
    {
      "name": "linux-x86-gcc-release",
      "displayName": "Release",
      "configurePreset": "linux-x86-gcc",
      "inherits": "release"
    },
    {
      "name": "linux-x86-clang-debug",
      "displayName": "Debug",
      "configurePreset": "linux-x86-clang",
      "inherits": "debug"
    },
    {
      "name": "linux-x86-clang-release",
      "displayName": "Release",
      "configurePreset": "linux-x86-clang",
      "inherits": "release"
    },
    {
      "name": "linux-arm-gcc-debug",
      "displayName": "Debug",
      "configurePreset": "linux-arm-gcc",
      "inherits": "debug"
    },
    {
      "name": "linux-arm-gcc-release",
      "displayName": "Release",
      "configurePreset": "linux-arm-gcc",
      "inherits": "release"
    },
    {
      "name": "linux-arm-clang-debug",
      "displayName": "Debug",
      "configurePreset": "linux-arm-clang",
      "inherits": "debug"
    },
    {
      "name": "linux-arm-clang-release",
      "displayName": "Release",
      "configurePreset": "linux-arm-clang",
      "inherits": "release"
    },
    {
      "name": "macos-x64-clang-debug",
      "displayName": "Debug",
      "configurePreset": "macos-x64-clang",
      "inherits": "debug"
    },
    {
      "name": "macos-x64-clang-release",
      "displayName": "Release",
      "configurePreset": "macos-x64-clang",
      "inherits": "release"
    },
    {
      "name": "macos-x64-gcc-debug",
      "displayName": "Debug",
      "configurePreset": "macos-x64-gcc",
      "inherits": "debug"
    },
    {
      "name": "macos-x64-gcc-release",
      "displayName": "Release",
      "configurePreset": "macos-x64-gcc",
      "inherits": "release"
    },
    {
      "name": "macos-arm-debug",
      "displayName": "Debug",
      "configurePreset": "macos-arm",
      "inherits": "debug"
    },
    {
      "name": "macos-arm-release",
      "displayName": "Release",
      "configurePreset": "macos-arm",
      "inherits": "release"
    },
    {
      "name": "cl-debug",
      "displayName": "Debug",
      "configurePreset": "cl",
      "inherits": "debug"
    },
    {
      "name": "cl-release",
      "displayName": "Release",
      "configurePreset": "cl",
      "inherits": "release"
    }
  ],
  "testPresets": []
}